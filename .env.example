# Names only - copy to .env.local and fill in values. Never put a real key in this file.
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_BUCKET=
AWS_REGION=us-east-1

# "true" turns on editor routes and "Edit post" links. It is write capability, not read visibility:
# enabling it locally is fine, but it must stay off in production until the editor has an auth wall.
ENABLE_CONTENT_EDITOR=

# Leave unset (or blank) to keep public pages reading the on-disk copies under src/data/. Set to "s3"
# only after draft/live content has been seeded into the bucket - that is what switches the four content
# pages to the released copy and lets a release go through. layout.json and landing.json stay bundled
# either way, so a bucket outage can never break the site shell.
CONTENT_LIVE_SOURCE=
