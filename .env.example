# Names only - copy to .env.local and fill in values. Never put a real key in this file.
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_BUCKET=
AWS_REGION=us-east-1

# "true" turns on editor routes and "Edit post" links. It is write capability, not read visibility:
# enabling it locally is fine, but it must stay off in production until the editor has an auth wall.
ENABLE_CONTENT_EDITOR=

# Editor auth. ENABLE_CONTENT_EDITOR decides whether the editor exists; these two decide who can use it.
# With EDITOR_EDIT_KEY unset an enabled editor cannot be unlocked at all, so a misconfigured deploy exposes
# no edit routes.
#
# In production these must be real environment variables on the deployment (for Vercel: Project Settings ->
# Environment Variables). SvelteKit only reads .env files while bundling, and adapter-vercel runs the built
# server against the platform's own environment - a value that lives in a local .env or .env.local is not
# available to the deployed server at all, so the editor stays shut and no "Edit" link appears anywhere.
EDITOR_EDIT_KEY=

# Signs editor session cookies. If unset, sessions are signed with an ephemeral key and each unlock ends at
# the next cold start - the editor still works, but has to be unlocked again after each deploy. Set it to a
# long random string so one unlock survives normal traffic.
EDITOR_SESSION_SECRET=

# Leave unset (or blank) to keep public pages reading the on-disk copies under src/data/. Set to "s3"
# only after draft/live content has been seeded into the bucket (npm run seed:s3) - that is what switches
# the content pages to the released copy and lets a release go through. layout.json and landing.json also
# read from S3 when this is set, but they fall back to their bundled payload on any bucket failure, so a
# failed read still renders the site shell from git rather than breaking every page.
CONTENT_LIVE_SOURCE=

# The bucket prefix every draft, live and history object is read from and written to. Leave unset (or blank)
# to use "data", which is where seed:s3 puts the objects production reads - a deploy that configures nothing
# keeps serving what is already in the bucket. Set it to a single lowercase segment like "dev-data" only when
# the editor runs against a bucket production also serves: without it, a dev draft, history snapshot or
# release lands on the objects visitors are reading. A dev prefix needs its own seed run - put
# CONTENT_S3_PREFIX=dev-data in the env file passed to npm run seed:s3 - because nothing else in the bucket
# holds that prefix's drafts.
CONTENT_S3_PREFIX=
