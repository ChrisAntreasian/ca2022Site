{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "strict": false,
    "allowJs": false,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "#lib/*": ["./src/lib/*"],
      "#data/*": ["./src/data/*"]
    }
  }
}
