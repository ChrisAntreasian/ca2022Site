{
  "name": "chris-a-sveltekit",
  "version": "2.2.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:encoding:all": "node scripts/check-mojibake.mjs --include-history",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --plugin-search-dir=. . && eslint .",
    "format": "prettier --write --plugin-search-dir=. .",
    "start": "vite preview",
    "postinstall": "svelte-kit sync"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/cookie": "^0.6.0",
    "@types/node": "22.20.5",
    "@types/qs": "6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "16.5.0",
    "happy-dom": "^18.0.1",
    "jsdom": "27.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.1",
    "svelte-preprocess": "^6.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@types/mixpanel-browser": "^2.60.0",
    "aws-sdk": "2.1693.0",
    "effect": "^3.17.14",
    "hamburgers": "^1.2.1",
    "mixpanel-browser": "2.84.0",
    "qs": "^6.13.2",
    "save": "^2.9.0",
    "svelte-exmarkdown": "^5.0.2"
  }
}
