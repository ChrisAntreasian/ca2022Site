{
  "name": "chris-a-sveltekit",
  "version": "2.2.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:encoding:all": "node scripts/check-mojibake.mjs --include-history",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "start": "vite preview",
    "postinstall": "svelte-kit sync"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#data/*": "./src/data/*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/qs": "6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@types/mixpanel-browser": "^2.60.0",
    "aws-sdk": "2.1693.0",
    "effect": "^3.22.4",
    "hamburgers": "^1.2.1",
    "mixpanel-browser": "2.84.0",
    "qs": "^6.17.1",
    "save": "^2.9.0",
    "svelte-exmarkdown": "^5.0.2"
  }
}
