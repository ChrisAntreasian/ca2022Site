{
  "name": "chris-a-sveltekit",
  "version": "2.2.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit package",
    "preview": "vite preview",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:encoding:all": "node scripts/check-mojibake.mjs --include-history",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "start": "node build/index.js",
    "postinstall": "svelte-kit sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.4",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "type": "module",
  "imports": {
    "#data/*": "./src/data/*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@types/mixpanel-browser": "^2.60.0",
    "effect": "^3.22.2",
    "hamburgers": "^1.2.1",
    "mixpanel-browser": "^2.83.0",
    "qs": "^6.16.0",
    "save": "^2.9.0",
    "svelte-exmarkdown": "^5.0.2"
  }
}
